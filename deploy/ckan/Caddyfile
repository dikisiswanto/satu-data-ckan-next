{
  admin off
}

{$PUBLIC_HOST} {
  encode zstd gzip
  # Public resource downloads are handled by the Next.js route, which checks
  # CKAN visibility and fetches the file over the private Docker network.
  @publicResourceDownload path_regexp publicResourceDownload ^/dataset/[^/]+/resource/[a-fA-F0-9-]{16,64}/download/[^/]+/?$
  handle @publicResourceDownload {
    reverse_proxy nextjs:3000 {
      header_up Host {http.request.host}
      header_up X-Forwarded-Host {http.request.host}
      header_up X-Forwarded-Proto {http.request.scheme}
    }
  }
  @ckanPublic path_regexp ckanPublic ^/(?:catalog\.(?:rdf|ttl|jsonld|xml|n3)|dataset/[^/]+\.(?:rdf|ttl|jsonld|n3))$
  handle @ckanPublic {
    reverse_proxy https://nginx:443 {
      header_up Host {http.request.host}
      header_up X-Forwarded-Proto {http.request.scheme}
      transport http {
        tls_insecure_skip_verify
      }
    }
  }
  handle {
    reverse_proxy nextjs:3000 {
      header_up Host {http.request.host}
      header_up X-Forwarded-Proto {http.request.scheme}
    }
  }
}

{$CKAN_HOST} {
  # Keep the dedicated administration hostname out of search indexes.
  header >X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex"
  encode zstd gzip

  route {
    # Do not publish an admin-host sitemap. robots.txt remains readable so the
    # crawler can observe the X-Robots-Tag response header.
    @adminRobots path /robots.txt
    respond @adminRobots "User-agent: *" 200

    @adminSitemap path /sitemap.xml /sitemap_index.xml /sitemap-*
    respond @adminSitemap "Not Found" 404

    # Proxy every route, including core catalogue views and all installed
    # extensions. WajoThemePlugin enforces login for this hostname and CKAN's
    # own permission checks remain authoritative after authentication.
    reverse_proxy https://nginx:443 {
      header_up Host {http.request.host}
      header_up X-Forwarded-Host {http.request.host}
      header_up X-Forwarded-Proto https
      transport http {
        tls_insecure_skip_verify
      }
    }
  }
}
