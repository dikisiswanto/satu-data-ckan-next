# SINGLE SOURCE OF CONFIGURATION: edit only this file. Bootstrap merges CKAN defaults here and renders a filtered service env.
# The only indexable/public portal hostname.
PUBLIC_HOST=data.wajokab.go.id
# Separate CKAN administration hostname. Prefer a first-level subdomain (for example ckan.example.com) for free Cloudflare Universal SSL on Full DNS Setup.
CKAN_HOST=ckan.wajokab.go.id
# none: CKAN host root redirects directly to the native login form; CKAN auth/roles remain active.
# basic_auth: optional extra Caddy Basic Auth before the CKAN login (manual/cloudflare profiles).
# cloudflare_access: optional Cloudflare Access perimeter + CKAN login (cloudflare-access profile).
# For cloudflare_access, configure a self-hosted application and explicit admin allow-list first.
CKAN_ADMIN_GATE_MODE=none

# Derived from PUBLIC_HOST/CKAN_HOST and PORTAL_* by sync-env.py; edit the canonical values above instead.
NEXT_PUBLIC_SITE_URL=https://data.wajokab.go.id
NEXT_PUBLIC_CKAN_ADMIN_URL=https://ckan.wajokab.go.id
NEXT_PUBLIC_GEOPORTAL_URL=
NEXT_PUBLIC_REGION_NAME=
NEXT_PUBLIC_BRAND_PROFILE=
NEXT_PUBLIC_REGION_SHORT_NAME=
NEXT_PUBLIC_APP_NAME=
NEXT_PUBLIC_SHORT_NAME=
NEXT_PUBLIC_ORGANIZATION_NAME=
NEXT_PUBLIC_PUBLIC_SUBTITLE=
NEXT_PUBLIC_SITE_DESCRIPTION=
NEXT_PUBLIC_LOGO_PATH=
NEXT_PUBLIC_LOGO_ALT=
NEXT_PUBLIC_HERO_IMAGE=
NEXT_PUBLIC_THEME_COLOR=
NEXT_PUBLIC_PWA_BACKGROUND_COLOR=
# Cookie name must match Flask SESSION_COOKIE_NAME. Keep this value stable across releases to preserve existing login sessions.
CKAN_SESSION_COOKIE_NAME=portal_ckan_session
# These Flask settings do not use the ckan. namespace; ckanext-envvars needs CKAN___ (triple underscore).
# sync-env.py derives the shared parent domain from PUBLIC_HOST and CKAN_HOST.
# SECURITY: every trusted subdomain of that parent domain receives this HttpOnly session cookie.
CKAN___SESSION_COOKIE_NAME=portal_ckan_session
CKAN___SESSION_COOKIE_DOMAIN=
CKAN___SESSION_COOKIE_HTTPONLY=true
CKAN___SESSION_COOKIE_SECURE=true
CKAN___SESSION_COOKIE_SAMESITE=Lax
PUBLIC_SITE_ORIGIN=https://data.wajokab.go.id
# Optional comma-separated browser origins allowed to call the read-only API. Defaults to PUBLIC_SITE_ORIGIN.
PUBLIC_API_CORS_ORIGINS=
CKAN_ADMIN_URL=https://ckan.wajokab.go.id

# Generated by bootstrap only in basic_auth mode. Leave blank when CKAN_ADMIN_GATE_MODE=none/cloudflare_access.
CKAN_ADMIN_BASIC_AUTH_USER=ckan-admin
CKAN_ADMIN_BASIC_AUTH_PASSWORD=
CKAN_ADMIN_BASIC_AUTH_HASH=

# First CKAN sysadmin. Bootstrap replaces the password marker with a random secret.
# Change the email to a monitored mailbox before the first container startup.
CKAN_SYSADMIN_NAME=ckan_admin
CKAN_SYSADMIN_PASSWORD=GENERATE_ON_BOOTSTRAP
CKAN_SYSADMIN_EMAIL=admin@wajokab.go.id

# CKAN 2.12 built-in modern theme (Midnight Blue). bootstrap-upstream.sh enforces these supported values.
CKAN__BASE_PUBLIC_FOLDER=public-midnight-blue
CKAN__BASE_TEMPLATES_FOLDER=templates-midnight-blue
# Branding native CKAN admin; the custom portal_theme plugin loads these across login and admin pages.
# ckanext-geoview Leaflet viewers need an explicit, live XYZ basemap.
# OpenLayers geo_view has its own OSM fallback; GeoJSON/WMTS/Shapefile Leaflet
# viewers read these common-map options. Keep attribution visible in the viewer.
CKANEXT__SPATIAL__COMMON_MAP__TYPE=custom
CKANEXT__SPATIAL__COMMON_MAP__CUSTOM__URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
CKANEXT__SPATIAL__COMMON_MAP__ATTRIBUTION=© OpenStreetMap contributors
CKANEXT__GEOVIEW__GEOJSON__MAX_FILE_SIZE=26214400
# FileStore CKAN 2.12: persistent uploads live inside the official ckan_storage volume.
# The default storage automatically provisions the derived group/user/admin stores.
CKAN__UPLOADS_ENABLED=true
CKAN__FILES__STORAGE__DEFAULT__TYPE=ckan:fs
CKAN__FILES__STORAGE__DEFAULT__PATH=/var/lib/ckan/default
CKAN__FILES__STORAGE__DEFAULT__INITIALIZE=true
CKAN__FILES__OWNER__CASCADE_ACCESS="package resource group organization portal_media"
CKAN__MAX_IMAGE_SIZE=5
CKAN__UPLOAD__GROUP__TYPES=image
CKAN__UPLOAD__GROUP__MIMETYPES="image/png image/jpeg image/gif image/webp"
# Scheming separates custom forms by CKAN entity. Dataset type remains `dataset` for API compatibility.
CKAN___SCHEMING__DATASET_SCHEMAS=ckanext.portal_theme:schemas/dataset.yaml
CKAN___SCHEMING__ORGANIZATION_SCHEMAS=ckanext.portal_theme:schemas/organization.yaml
CKAN___SCHEMING__GROUP_SCHEMAS=ckanext.portal_theme:schemas/group.yaml
CKAN___SCHEMING__PRESETS=ckanext.scheming:presets.json
# Bahasa Indonesia menjadi bahasa bawaan antarmuka CKAN; English tetap tersedia sebagai pilihan.
CKAN__LOCALE_DEFAULT=id
CKAN__LOCALES_OFFERED="id en"
CKAN__LOCALE_ORDER="id en"
# Setelah login sukses, arahkan pengelola ke halaman ringkasan Portal Admin.
CKAN__AUTH__ROUTE_AFTER_LOGIN=portal_admin.index
# Derived by sync-env.py from CKAN_HOST; used only by the CKAN admin-host login guard.
CKANEXT__PORTAL_THEME__ADMIN_HOST=ckan.wajokab.go.id
# Internal signed webhook for invalidating Next.js public cache after CKAN changes. Bootstrap generates this secret.
CKAN_REVALIDATE_SECRET=GENERATE_ON_BOOTSTRAP
# CKAN Pages is the headless CMS source; Next.js renders all public pages.
CKANEXT__PAGES__ALLOW_HTML=false
CKANEXT__PAGES__REVISIONS_LIMIT=5
CKANEXT__PAGES__REVISIONS_FORCE_LIMIT=true

# Server-only CKAN Action API endpoint inside the Docker network.
CKAN_API_INTERNAL_URL=http://ckan:5000/api/3/action
CKAN_API_TIMEOUT_MS=8000
CKAN_INDICATOR_TAG=portal-indikator
CKAN_INFOGRAPHIC_TAG=portal-infografik
CKAN_PUBLICATION_TAG=portal-publikasi

# XLoader API token is created after the first CKAN startup by enable-xloader.sh.
# The token and worker-only DB settings are passed only to CKAN/XLoader worker.
CKANEXT__XLOADER__API_TOKEN=NOT_SET
CKANEXT__XLOADER__JOBS_DB__URI=
CKANEXT__XLOADER__SITE_URL=http://ckan:5000

# Set only for Cloudflare Tunnel profile. Keep token private.
CLOUDFLARE_TUNNEL_TOKEN=

# SINGLE SOURCE FOR INSTITUTION IDENTITY. Change this block when deploying
# another institution; sync-env.py derives the corresponding CKAN and Next.js
# settings. The values below intentionally preserve the Wajo deployment default.
PORTAL_INSTITUTION_NAME=Kabupaten Wajo
PORTAL_INSTITUTION_SHORT_NAME=Wajo
PORTAL_BRAND_NAME=Portal Satu Data Kabupaten Wajo
PORTAL_SHORT_NAME=Satu Data Wajo
PORTAL_ORGANIZATION_NAME=Pemerintah Kabupaten Wajo
PORTAL_SITE_DESCRIPTION=Portal resmi untuk menemukan, memahami, dan menggunakan data publik Kabupaten Wajo.
PORTAL_PUBLIC_SUBTITLE=Portal Data Kabupaten Wajo
PORTAL_BRAND_PROFILE=wajo
PORTAL_LOGO_PATH=/institution-logo-default.webp
PORTAL_LOGO_ALT=Lambang Kabupaten Wajo
PORTAL_HERO_IMAGE=/portal-hero-panorama.webp
PORTAL_ICON_PATH=/icons/icon.svg
PORTAL_PWA_ICON_192=/icons/icon-192.png
PORTAL_PWA_ICON_512=/icons/icon-512.png
PORTAL_PPID_NAME=PPID Kabupaten Wajo
PORTAL_PPID_URL=https://e-ppid-utama.wajokab.go.id/
PORTAL_PPID_CONTACT_URL=https://e-ppid-utama.wajokab.go.id/kontak/
PORTAL_PPID_ADDRESS=Jl. Rusa No. 17, Bulu Pabbulu, Kecamatan Tempe, Kabupaten Wajo, Sulawesi Selatan 90911
PORTAL_PPID_EMAIL=ppid@wajokab.go.id
PORTAL_PPID_PHONE=+62 811-4780-6767
PORTAL_THEME_COLOR=#174566
PORTAL_PWA_BACKGROUND_COLOR=#f4f6f8
# Internal CKAN ownership identifiers are generic by default and configurable.
PORTAL_MEDIA_OWNER_TYPE=portal_media
PORTAL_MEDIA_OWNER_ID=public-editorial-media
# Optional legacy extension prefixes removed during upgrade; clear after migration.
PORTAL_LEGACY_EXTENSION_PREFIXES=wajo
PORTAL_LEGACY_DATASET_VIEW_COOKIE_NAME=wajo_dataset_view
PORTAL_LEGACY_PWA_STORAGE_PREFIX=wajo:pwa-install-promotion
# Derived by sync-env.py from PORTAL_*; do not edit these NEXT_PUBLIC values.
NEXT_PUBLIC_LEGACY_DATASET_VIEW_COOKIE_NAME=
NEXT_PUBLIC_LEGACY_PWA_STORAGE_PREFIX=
NEXT_PUBLIC_ICON_PATH=
NEXT_PUBLIC_PWA_ICON_192=
NEXT_PUBLIC_PWA_ICON_512=
NEXT_PUBLIC_PPID_NAME=PPID Kabupaten Wajo
NEXT_PUBLIC_PPID_URL=https://e-ppid-utama.wajokab.go.id/
NEXT_PUBLIC_PPID_CONTACT_URL=https://e-ppid-utama.wajokab.go.id/kontak/
NEXT_PUBLIC_PPID_ADDRESS=Jl. Rusa No. 17, Bulu Pabbulu, Kecamatan Tempe, Kabupaten Wajo, Sulawesi Selatan 90911
NEXT_PUBLIC_PPID_EMAIL=ppid@wajokab.go.id
NEXT_PUBLIC_PPID_PHONE=+62 811-4780-6767
NEXT_PUBLIC_LOCALE=id-ID
NEXT_PUBLIC_TIME_ZONE=Asia/Makassar
# XYZ basemap used by the public GeoJSON preview; use a provider URL compatible with {z}/{x}/{y}.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
