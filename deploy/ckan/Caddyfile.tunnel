# Cloudflare terminates public TLS; the private Tunnel origin is HTTP only.
{
  auto_https off
  admin off
}

http://{$PUBLIC_HOST} {
  encode zstd gzip
  # Public resource downloads are handled by the Next.js route, which checks
  # CKAN visibility and fetches the file over the private Docker network.
  # CKAN ResourceView pages (GeoJSON/Map Viewer) are HTML served by CKAN,
  # not by the Next.js portal. The CKAN site_url deliberately stays on the
  # public host, so these narrow routes must reach CKAN or Next.js will answer
  # the iframe request with its global X-Frame-Options: DENY.
  @ckanResourceView path_regexp ckanResourceView ^/dataset/[^/]+/resource/[^/]+/(view/[^/]+|preview|embed)/?$
  handle @ckanResourceView {
    reverse_proxy https://nginx:443 {
      header_up Host {http.request.host}
      header_up X-Forwarded-Host {http.request.host}
      header_up X-Forwarded-Proto https
      # This route is used only by the CKAN admin ResourceView iframe. Permit
      # that one trusted parent origin; do not make the entire portal frameable.
      header_down -X-Frame-Options
      header_down -Content-Security-Policy
      header_down Content-Security-Policy "frame-ancestors 'self' https://{$CKAN_HOST} https://{$PUBLIC_HOST}"
      header_down Cache-Control "private, no-store"
      transport http {
        tls_insecure_skip_verify
      }
    }
  }

  # CKAN's viewer HTML references WebAssets and CKAN static resources from
  # root-relative URLs. Keep these asset prefixes on CKAN; Next.js owns all
  # other public paths.
  @ckanViewerAssets path /webassets/* /base/* /static/* /fanstatic/*
  handle @ckanViewerAssets {
    reverse_proxy https://nginx:443 {
      header_up Host {http.request.host}
      header_up X-Forwarded-Host {http.request.host}
      header_up X-Forwarded-Proto https
      transport http {
        tls_insecure_skip_verify
      }
    }
  }

  # GeoView can fetch off-domain source files through CKAN's resource_proxy
  # Action API. Forward only that action to CKAN; keep the rest of the public
  # Next.js API namespace on Next.js.
  # CKAN ResourceView JS builds this URL from ckan.site_url (PUBLIC_HOST).
  # The public host normally belongs to Next.js, so forward only the public,
  # read-only translation endpoint back to CKAN. ResourceViews opened on
  # CKAN_HOST are cross-origin relative to PUBLIC_HOST; allow that exact admin
  # origin instead of enabling wildcard/global CKAN CORS.
  @ckanGeoPreflight {
    path /api/i18n/* /api/3/action/resource_proxy /api/action/resource_proxy
    method OPTIONS
  }
  handle @ckanGeoPreflight {
    header Access-Control-Allow-Origin "https://{$CKAN_HOST}"
    header Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
    header Access-Control-Allow-Headers "Accept, Content-Type, X-Requested-With, Range"
    header Access-Control-Max-Age "600"
    header +Vary Origin
    respond "" 204
  }

  @ckanI18n path /api/i18n/*
  handle @ckanI18n {
    header {
      -Access-Control-Allow-Origin
      -Access-Control-Allow-Credentials
      >Access-Control-Allow-Origin "https://{$CKAN_HOST}"
      >Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
      +Vary Origin
    }
    reverse_proxy https://nginx:443 {
      header_up Host {http.request.host}
      header_up X-Forwarded-Host {http.request.host}
      header_up X-Forwarded-Proto https
      transport http {
        tls_insecure_skip_verify
      }
    }
  }

  @ckanResourceProxy path /api/3/action/resource_proxy /api/action/resource_proxy
  handle @ckanResourceProxy {
    # GeoView's admin page calls the public-host resource proxy using
    # ckan.site_url. Permit only the paired CKAN admin origin for browser XHR.
    header {
      -Access-Control-Allow-Origin
      -Access-Control-Allow-Credentials
      >Access-Control-Allow-Origin "https://{$CKAN_HOST}"
      >Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
      >Access-Control-Allow-Headers "Accept, Content-Type, X-Requested-With, Range"
      >Access-Control-Expose-Headers "Content-Length, Content-Range, Accept-Ranges, Content-Type"
      +Vary Origin
    }
    reverse_proxy https://nginx:443 {
      header_up Host {http.request.host}
      header_up X-Forwarded-Host {http.request.host}
      header_up X-Forwarded-Proto https
      header_down Cache-Control "private, no-store"
      transport http {
        tls_insecure_skip_verify
      }
    }
  }

  @publicResourceDownload path_regexp publicResourceDownload ^/dataset/[^/]+/resource/[a-fA-F0-9-]{16,64}/download/[^/]+/?$
  handle @publicResourceDownload {
    reverse_proxy nextjs:3000 {
      header_up Host {http.request.host}
      header_up X-Forwarded-Host {http.request.host}
      header_up X-Forwarded-Proto {http.request.scheme}
    }
  }
  @ckanPublic path_regexp ckanPublic ^/(catalog\.(rdf|ttl|jsonld|xml|n3)|dataset/[^/]+\.(rdf|ttl|jsonld|n3))$
  handle @ckanPublic {
    reverse_proxy https://nginx:443 {
      header_up Host {http.request.host}
      header_up X-Forwarded-Host {http.request.host}
      header_up X-Forwarded-Proto https
      transport http {
        tls_insecure_skip_verify
      }
    }
  }
  handle {
    reverse_proxy nextjs:3000 {
      header_up Host {http.request.host}
      header_up X-Forwarded-Host {http.request.host}
      header_up X-Forwarded-Proto https
    }
  }
}

http://{$CKAN_HOST} {
  # Keep the dedicated administration hostname out of search indexes.
  header >X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex"
  encode zstd gzip

  route {
    # Do not publish an admin-host sitemap. robots.txt remains readable so the
    # crawler can observe the X-Robots-Tag response header.
    @adminRobots path /robots.txt
    respond @adminRobots "User-agent: *" 200

    @adminSitemap path /sitemap.xml /sitemap_index.xml /sitemap-*
    respond @adminSitemap "Not Found" 404

    # ResourceView may be generated against CKAN_HOST in existing datasets.
    # Keep its iframe policy deterministic on the admin origin as well as the
    # equivalent public-host route; all other CKAN pages retain native headers.
    @adminResourceView path_regexp adminResourceView ^/dataset/[^/]+/resource/[^/]+/(view/[^/]+|preview|embed)/?$
    handle @adminResourceView {
      reverse_proxy https://nginx:443 {
        header_up Host {http.request.host}
        header_up X-Forwarded-Host {http.request.host}
        header_up X-Forwarded-Proto https
        header_down -X-Frame-Options
        header_down -Content-Security-Policy
        header_down Content-Security-Policy "frame-ancestors 'self' https://{$PUBLIC_HOST}"
        header_down Cache-Control "private, no-store"
        transport http {
          tls_insecure_skip_verify
        }
      }
    }

    # Proxy every route, including core catalogue views and all installed
    # extensions. WajoThemePlugin enforces login for this hostname and CKAN's
    # own permission checks remain authoritative after authentication.
    reverse_proxy https://nginx:443 {
      header_up Host {http.request.host}
      header_up X-Forwarded-Host {http.request.host}
      header_up X-Forwarded-Proto https
      transport http {
        tls_insecure_skip_verify
      }
    }
  }
}
