{
  "name": "satu-data-ckan-next",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.16.0 <25",
    "npm": ">=10.9.2"
  },
  "packageManager": "npm@10.9.2",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "npm run check:static && npm run lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:coverage": "vitest run --coverage",
    "security:check": "npm audit --omit=dev",
    "format:write": "prettier --write \"src/**/*.{js,jsx,mjs,cjs,json,css}\" \"tests/**/*.{js,jsx,mjs,cjs,json,css}\" \"scripts/**/*.{js,jsx,mjs,cjs,json,css}\" \"deploy/ckan/**/*.{js,jsx,mjs,cjs,json,css,yml,yaml,md}\" \"docs/**/*.md\" \"*.md\" \"*.json\" \"*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,mjs,cjs,json,css}\" \"tests/**/*.{js,jsx,mjs,cjs,json,css}\" \"scripts/**/*.{js,jsx,mjs,cjs,json,css}\" \"deploy/ckan/**/*.{js,jsx,mjs,cjs,json,css,yml,yaml,md}\" \"docs/**/*.md\" \"*.md\" \"*.json\" \"*.mjs\"",
    "check:static": "bash scripts/check-static.sh",
    "fix": "npm run format:write && npm run lint:fix"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.53.0",
    "next": "^16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/forms": "0.5.10",
    "@tailwindcss/postcss": "4.3.3",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "husky": "9.1.7",
    "lint-staged": "16.2.7",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "vitest": "5.0.3"
  },
  "lint-staged": {
    "**/*.{js,jsx,mjs,cjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "**/*.{css,json,md,yaml,yml}": "prettier --write"
  }
}
